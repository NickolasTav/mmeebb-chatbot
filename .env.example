# =============================================================================
# Modelo de Variáveis de Ambiente (.env.example) — Chatbot MMEEBB UNIPAM
# Copie este arquivo para .env e preencha suas chaves antes de iniciar a aplicação.
# =============================================================================

# Google Gemini AI (Chave de API do Google e Modelos)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-001
GEMINI_TEMPERATURE=0.2

# Chave de Administração REST (X-API-KEY / api_key)
ADMIN_API_KEY=teste

# Banco de Dados PostgreSQL & pgvector (Docker Local)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mmeebb_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis — estado conversacional do chatbot (Docker Local)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
MMEEBB_SESSION_TTL_MINUTES=60

# Agendador de notificações diárias (cron Spring, fuso America/Sao_Paulo)
MMEEBB_SCHEDULER_CRON=0 0 8 * * *

# RabbitMQ (Docker Local)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# Gateway Uaizap (WhatsApp)
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_API_KEY=
UAZAPI_INSTANCE=
UAZAPI_TYPING_DELAY_MS=2000
