# =============================================================================
# Variáveis de Ambiente - Chatbot MMEEBB UNIPAM
# =============================================================================
# Copie este arquivo para .env e preencha com as suas credenciais reais:
# cp .env.example .env
# =============================================================================

# --- Banco de Dados PostgreSQL & pgvector ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mmeebb_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- RabbitMQ ---
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --- Uazapi (Gateway WhatsApp) ---
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_API_KEY=
UAZAPI_INSTANCE=
UAZAPI_TYPING_DELAY_MS=2000

# --- Google Gemini AI (NLU & Tutor Clínico) ---
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2

# --- Administração & Endpoints REST (/api/admin/**) ---
ADMIN_API_KEY=

# --- Servidor ---
PORT=8080
