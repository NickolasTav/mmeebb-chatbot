# =============================================================================
# Modelo de Variáveis de Ambiente (.env.example) — Chatbot MMEEBB UNIPAM
# Copie este arquivo para .env e preencha suas chaves antes de iniciar a aplicação.
# Todas as chaves abaixo existem no application.yml (ou no docker-compose.yml);
# o valor que aparece aqui é o PADRÃO do código ou um placeholder. Nunca versione o .env.
# =============================================================================

# --- Google Gemini AI (Chave de API do Google e Modelos) ---------------------
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
# Modelo de chat único (tutor, roteamento de intenção, correção semântica, relatório).
# Em 503/429 o cliente faz failover automático gemini-3.5-flash-lite <-> gemini-3.5-flash.
# Não há modelo de embeddings: a base de conhecimento (RAG) foi removida.
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2

# --- Chave de Administração REST (header X-API-KEY / api_key) ----------------
# Protege /api/admin/** e o painel /setup (/api/v1/setup/**). TROQUE o padrão "teste".
ADMIN_API_KEY=troque_esta_chave_admin

# --- Servidor ----------------------------------------------------------------
PORT=8080

# --- Banco de Dados PostgreSQL (Docker Local) --------------------------------
# Porta do host mapeada para o Postgres no docker-compose.yml (mude se a 5432 estiver ocupada
# e ajuste a porta em SPRING_DATASOURCE_URL de acordo).
POSTGRES_HOST_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mmeebb_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Redis — estado conversacional do chatbot (Docker Local) -----------------
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
MMEEBB_SESSION_TTL_MINUTES=60

# --- Tutor de IA — memória curta da conversa ---------------------------------
# Trocas (pergunta + resposta) lembradas por aluno e minutos sem conversa até esquecer.
MMEEBB_TUTOR_HISTORY_MAX_TURNS=6
MMEEBB_TUTOR_HISTORY_TTL_MINUTES=30

# --- Agendador de notificações diárias (cron Spring, fuso America/Sao_Paulo) -
MMEEBB_SCHEDULER_CRON=0 */5 * * * *

# --- Personalização adaptativa por desempenho (MMEEBB Adaptativo) ------------
# enabled=false devolve o sistema ao MMEEBB clássico — útil para comparação experimental
MMEEBB_ADAPTIVE_ENABLED=true
MMEEBB_ADAPTIVE_WINDOW_DAYS=90
MMEEBB_ADAPTIVE_MIN_ATTEMPTS=3
MMEEBB_ADAPTIVE_FRAGILE_ERROR_RATE=0.50
MMEEBB_ADAPTIVE_CONSOLIDATING_ERROR_RATE=0.20
MMEEBB_ADAPTIVE_REINFORCEMENT_MAX_CARDS=2
MMEEBB_ADAPTIVE_REPORT_MIN_ATTEMPTS=5

# --- Limite diário de questões ---------------------------------------------
# Padrão para quem não escolheu um limite próprio; mín./máx. = faixa aceita no menu de Configurações
MMEEBB_DAILY_LIMIT_DEFAULT=20
MMEEBB_DAILY_LIMIT_MIN=5
MMEEBB_DAILY_LIMIT_MAX=100
# Parcela do limite reservada para questões novas (0.25 = 5 de 20, mínimo 1); 0 = revisões ocupam tudo
MMEEBB_DAILY_LIMIT_NEW_SHARE=0.25

# --- RabbitMQ (Docker Local) -------------------------------------------------
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --- Gateway Uazapi (WhatsApp) -----------------------------------------------
# ATENÇÃO (achado A1): a migration V6 grava uazapi.base-url (e, pelo painel /setup, instância e token)
# na tabela system_configurations, e o VALOR DO BANCO VENCE o .env. Mudar UAZAPI_BASE_URL aqui não
# surte efeito num banco já migrado: altere pelo painel /setup ou com
#   update system_configurations set config_value = '<url>' where config_key = 'uazapi.base-url';
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_API_KEY=
UAZAPI_INSTANCE=
UAZAPI_TYPING_DELAY_MS=2000
# Consumidores simultâneos da fila de entrada (faixa min-max do RabbitMQ)
UAZAPI_INBOUND_CONCURRENCY=3-6

# Admintoken da sua conta Uazapi (free.uazapi.com/uazapi.dev) — usado só para provisionar
# instâncias novas automaticamente via painel /setup (POST /api/v1/setup/instance/provision).
# Instâncias do servidor demo gratuito expiram em 1h; UAZAPI_API_KEY/UAZAPI_INSTANCE acima
# passam a ser apenas o fallback inicial, pois o valor real fica salvo em system_configurations.
UAZAPI_ADMIN_TOKEN=

# --- Anti-banimento da fila de saída -----------------------------------------
# global (padrão, estratégia original): um único consumidor dorme jitter 3-6 s + composing de cada
#   mensagem, então alunos diferentes esperam uns pelos outros (10º aluno simultâneo ~ 62 s).
# per-recipient: cada aluno mantém o mesmo jitter + composing, sem somar esperas entre alunos
#   (10º aluno ~ 19 s). A decisão de ligar em produção é do dono do projeto (altera o ritmo de envio).
UAZAPI_ANTI_BAN_MODE=global
# Intervalo mínimo (ms) entre dois textos quaisquer; só vale no modo per-recipient (1000 ms = até ~60/min).
UAZAPI_ANTI_BAN_GLOBAL_MIN_INTERVAL_MS=1000

# --- Ngrok (painel /setup) ---------------------------------------------------
# API local de controle do Ngrok, usada para descobrir a URL pública do túnel.
NGROK_CLIENT_API_URL=http://127.0.0.1:4040

# --- Observabilidade — Grafana (Docker Local, opcional, tem default no docker-compose) ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Somente testes ----------------------------------------------------------
# Porta do Redis real usado pelo RedisChatSessionStoreTest (ignorado quando não há Redis nela).
# Lida do ambiente do processo de teste, não do .env.
# REDIS_IT_PORT=6399
