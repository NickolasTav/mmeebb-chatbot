{
  "id": null,
  "uid": "mmeebb-overview",
  "title": "MMEEBB — Observabilidade",
  "tags": ["mmeebb", "tcc"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "phone",
        "type": "textbox",
        "label": "Telefone do aluno",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "App Up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"med-mmeebb-app\"}", "legendFormat": "up" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Taxa de Erro HTTP 5xx (%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{
        "expr": "100 * sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
        "legendFormat": "erro %"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2 } }
    },
    {
      "id": 3,
      "title": "Revisões processadas (1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(increase(med_mmeebb_reviews_total[1h]))", "legendFormat": "reviews" }]
    },
    {
      "id": 4,
      "title": "Mensagens WhatsApp enviadas (1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{
        "expr": "sum(increase(med_mmeebb_uaizap_messages_total{direction=\"OUTBOUND\"}[1h]))",
        "legendFormat": "outbound"
      }]
    },
    {
      "id": 10,
      "title": "Taxa de Requisições HTTP por rota/status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (uri, status)",
        "legendFormat": "{{uri}} [{{status}}]"
      }]
    },
    {
      "id": 11,
      "title": "Latência HTTP P95/P99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 20,
      "title": "Revisões MMEEBB por resultado",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [{
        "expr": "sum(rate(med_mmeebb_reviews_total[5m])) by (result)",
        "legendFormat": "{{result}}"
      }]
    },
    {
      "id": 21,
      "title": "Mensagens WhatsApp por direção",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [{
        "expr": "sum(rate(med_mmeebb_uaizap_messages_total[5m])) by (direction)",
        "legendFormat": "{{direction}}"
      }]
    },
    {
      "id": 22,
      "title": "Roteamento de IA (Gemini vs fast-path vs fallback)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [{
        "expr": "sum(rate(med_mmeebb_ai_interactions_total[5m])) by (source, path)",
        "legendFormat": "{{source}}/{{path}}"
      }]
    },
    {
      "id": 30,
      "title": "JVM Heap Usado / Máximo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "usado" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "máximo" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 31,
      "title": "Pausas de GC",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "targets": [{
        "expr": "sum(rate(jvm_gc_pause_seconds_sum[5m]))",
        "legendFormat": "GC pause/s"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 32,
      "title": "CPU do Processo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "targets": [{ "expr": "process_cpu_usage", "legendFormat": "CPU" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 40,
      "title": "Logs da aplicação (ERROR/WARN em destaque)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 28 },
      "targets": [{ "expr": "{job=\"med-mmeebb-app\"} |= \"ERROR\" or {job=\"med-mmeebb-app\"} |= \"WARN\"" }]
    },
    {
      "id": 41,
      "title": "Histórico de um aluno específico ($phone)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 28 },
      "targets": [{ "expr": "{job=\"med-mmeebb-app\"} |= \"$phone\"" }]
    }
  ]
}
